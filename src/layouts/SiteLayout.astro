---
const { title = 'Makta Media', description = 'Performance advertising for ambitious brands across Indonesia and Singapore.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171713" /><meta name="description" content={description} />
    <title>{title} — Makta Media</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header"><a class="brand" href="/" aria-label="Makta Media home"><span class="brand-symbol" aria-hidden="true"></span><span><b>makta</b><small>media</small></span></a>
      <nav class="primary-nav" aria-label="Main navigation"><a href="/calculator">Calculator</a><a href="/services">Services</a><a href="/about">About</a><a href="/work">Work</a><a href="/blog">Blog</a></nav>
      <div class="header-actions"><a class="talk-link" href="/contact">LET'S TALK <span>↗</span></a></div>
    </header>
    <main class="site-main"><div class="parallax-field" aria-hidden="true"><span class="parallax-glow parallax-glow-orange" data-parallax-speed=".2"></span><span class="parallax-glow parallax-glow-beige" data-parallax-speed=".08"></span></div><slot /></main>
    <footer class="site-footer"><a class="brand" href="/" aria-label="Makta Media home"><span class="brand-symbol" aria-hidden="true"></span><span><b>makta</b><small>media</small></span></a><p>Performance advertising, built around your business.</p><nav aria-label="Footer navigation"><a href="/services">Services</a><a href="/work">Work</a><a href="/blog">Journal</a><a href="/contact">Contact</a></nav><small>© 2026 MAKTA MEDIA</small></footer>
    <script>
      const parallaxLayers = [...document.querySelectorAll('[data-parallax-speed]')];
      let parallaxFrame = 0;
      const moveParallax = () => {
        if (parallaxFrame) return;
        parallaxFrame = requestAnimationFrame(() => {
          const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reducedMotion) parallaxLayers.forEach((layer) => { layer.style.translate = `0 ${Math.round(scrollY * Number(layer.dataset.parallaxSpeed))}px`; });
          parallaxFrame = 0;
        });
      };
      addEventListener('scroll', moveParallax, { passive: true });
      moveParallax();
    </script>
  </body>
</html>
<style is:global>
  .site-main{position:relative;isolation:isolate;overflow:hidden}.site-main>.parallax-field{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}.site-main>.page{position:relative;z-index:1}.parallax-glow{position:absolute;display:block;aspect-ratio:1;border-radius:50%;will-change:translate;filter:blur(20px)}.parallax-glow-orange{top:4%;right:-18%;width:min(66vw,850px);background:radial-gradient(circle,rgba(244,119,67,.19),rgba(190,87,48,.09) 39%,transparent 70%)}.parallax-glow-beige{top:43%;left:-23%;width:min(48vw,570px);background:radial-gradient(circle,rgba(238,232,220,.09),rgba(244,119,67,.045) 36%,transparent 70%)}
  :root{--ink:#171713;--ink-soft:#22221c;--paper:#eee8dc;--accent:#f47743;--muted:#a9a398;--rule:rgba(238,232,220,.15);--sans:'Inter',sans-serif;--display:'Manrope',sans-serif;--mono:'DM Mono',monospace}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ink);color:var(--paper);font-family:var(--sans);-webkit-font-smoothing:antialiased}body.menu-is-open{overflow:hidden}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit}.site-header{height:76px;position:fixed;z-index:30;inset:0 0 auto;padding:0 5.5%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;background:rgba(23,23,19,.88);border-bottom:1px solid rgba(238,232,220,.11);backdrop-filter:blur(18px)}.brand{display:flex;align-items:center;gap:8px;width:max-content;color:var(--paper)}.brand>span:last-child{display:flex;align-items:baseline;gap:3px;font-family:var(--display);letter-spacing:-.06em}.brand b{font-size:16px}.brand small{font-size:12px;color:#c9c1b3}.brand-symbol{display:block;width:24px;height:24px;background:url('https://images.squarespace-cdn.com/content/69ccbe9585db7a417fa43c2d/7f8b319d-c994-477c-b624-b9bba989c9d9/Makta%20Media%20Logogram_Red%20%281%29.png?format=300w') center/300% 300% no-repeat}.primary-nav{display:flex;gap:clamp(15px,2.2vw,32px);align-items:center}.primary-nav a{font-size:11px;color:#c4bfb4;transition:color .2s}.primary-nav a:hover,.site-footer nav a:hover{color:var(--accent)}.header-actions{justify-self:end;display:flex;align-items:center;gap:23px}.talk-link{font:9px var(--mono);letter-spacing:.08em}.talk-link span{margin-left:7px;color:var(--accent)}.nav-toggle{width:34px;height:34px;background:none;border:0;display:grid;align-content:center;gap:6px;cursor:pointer}.nav-toggle i{width:20px;height:1px;background:var(--paper);transition:transform .25s}.nav-toggle[aria-expanded=true] i:first-child{transform:translateY(3.5px) rotate(45deg)}.nav-toggle[aria-expanded=true] i:last-child{transform:translateY(-3.5px) rotate(-45deg)}.menu-scrim{position:fixed;inset:0;z-index:29;background:#171713;padding:112px 9% 35px;display:flex;flex-direction:column;justify-content:space-between;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .3s,visibility .3s}.menu-scrim.is-open{opacity:1;visibility:visible;pointer-events:auto}.menu-meta{display:flex;justify-content:space-between;color:#aaa398;font:9px var(--mono);letter-spacing:.12em}.menu-dismiss{background:none;border:0;color:var(--paper);font:9px var(--mono);cursor:pointer}.menu-scrim nav{display:grid;align-self:center;width:min(800px,100%)}.menu-scrim nav a{display:grid;grid-template-columns:44px 1fr 30px;gap:8px;align-items:center;padding:11px 0;border-bottom:1px solid var(--rule);font:600 clamp(27px,4.6vw,52px)/1.15 var(--display);letter-spacing:-.065em}.menu-scrim nav small{font:9px var(--mono);color:#958f82;letter-spacing:0}.menu-scrim nav b{justify-self:end;color:var(--accent);font:400 17px var(--sans)}.menu-scrim>p{font:8px var(--mono);color:#958f82;letter-spacing:.11em}.site-main{min-height:70vh;padding-top:76px}.site-footer{padding:26px 5.5%;min-height:100px;display:grid;grid-template-columns:1fr 1.3fr 1.5fr auto;align-items:center;gap:22px;background:#12120f;border-top:1px solid var(--rule)}.site-footer .brand b{font-size:14px}.site-footer .brand small{font-size:10px}.site-footer .brand-symbol{width:20px;height:20px}.site-footer>p{color:var(--muted);font-size:10px}.site-footer nav{display:flex;justify-content:center;gap:20px}.site-footer nav a,.site-footer>small{color:#a9a398;font:8px var(--mono);letter-spacing:.04em}.page{max-width:1400px;margin:0 auto;padding:82px 8% 108px}.eyebrow{display:flex;align-items:center;gap:9px;margin:0;color:#b5ad9f;font:9px var(--mono);letter-spacing:.13em;text-transform:uppercase}.eyebrow:before{content:'';width:6px;height:6px;background:var(--accent);border-radius:50%;box-shadow:0 0 12px #f4774380}.page-title{max-width:950px;margin:26px 0 24px;font:600 clamp(48px,8vw,108px)/.99 var(--display);letter-spacing:-.085em}.page-title em{color:var(--accent);font-style:normal}.page-intro{max-width:640px;color:#c2bcaf;font-size:15px;line-height:1.8}.page-topline{display:flex;justify-content:space-between;align-items:center;color:#a9a398;font:8px var(--mono);letter-spacing:.11em;text-transform:uppercase}.page-topline a{color:var(--paper)}.page-topline a span{color:var(--accent);padding-left:8px}.panel{background:#202019;border:1px solid rgba(238,232,220,.13);padding:clamp(20px,4vw,42px)}.accent-link{display:inline-flex;gap:20px;align-items:center;padding:15px 18px;background:var(--accent);color:#211811;font:600 10px var(--mono);transition:transform .2s,background .2s}.accent-link:hover{transform:translateY(-3px);background:#ff9364}.quiet-link{font-size:11px;color:#d2cbbc;border-bottom:1px solid #7e7769;padding-bottom:5px}.card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.feature-card{position:relative;padding:25px;background:linear-gradient(145deg,#25251e,#1a1a15);border:1px solid var(--rule);min-height:245px;overflow:hidden;transition:transform .35s,border-color .35s}.feature-card:hover{transform:translateY(-6px);border-color:#f4774370}.feature-card:after{content:'';position:absolute;right:-44px;bottom:-72px;width:180px;height:180px;border:1px solid #f477432d;border-radius:50%;box-shadow:0 0 0 24px #f4774308,0 0 0 50px #f4774306}.feature-card small{color:var(--accent);font:9px var(--mono);letter-spacing:.1em}.feature-card h2,.feature-card h3{position:relative;z-index:1;margin:35px 0 12px;font:600 clamp(20px,2.7vw,30px)/1.12 var(--display);letter-spacing:-.055em}.feature-card p{position:relative;z-index:1;max-width:380px;color:#b6b0a3;font-size:11px;line-height:1.8}.cta-band{margin-top:60px;padding:30px 0;border-top:1px solid var(--rule);display:flex;align-items:center;justify-content:space-between;gap:20px}.cta-band h2{font:500 clamp(24px,4vw,42px) var(--display);letter-spacing:-.06em;margin:0}.cta-band em{color:var(--accent);font-style:normal}.reveal-in{animation:fade-up .8s cubic-bezier(.2,.7,.2,1) both}.reveal-in.delay{animation-delay:.15s}@keyframes fade-up{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}@media(max-width:900px){.site-header{grid-template-columns:1fr auto;padding:0 5%}.primary-nav{display:none}.site-footer{grid-template-columns:1fr auto}.site-footer>p{grid-row:2;grid-column:1/-1;margin:0}.site-footer nav{grid-column:1/-1;justify-content:flex-start;flex-wrap:wrap}.site-footer>small{grid-column:2;grid-row:1}.page{padding:64px 6% 80px}.card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.site-header{height:64px}.site-main{padding-top:64px}.header-actions{gap:12px}.brand b{font-size:15px}.brand small{font-size:11px}.menu-scrim{padding:83px 6% 25px}.menu-scrim nav a{grid-template-columns:30px 1fr 20px;padding:10px 0;font-size:clamp(25px,7.5vw,34px)}.menu-scrim>p{font-size:6px}.page{padding-top:54px}.page-title{font-size:clamp(48px,13vw,72px)}.page-intro{font-size:13px}.eyebrow{font-size:7px}.card-grid{grid-template-columns:1fr}.feature-card{min-height:210px}.cta-band{align-items:flex-start;flex-direction:column;margin-top:42px}.site-footer{padding:22px 6%;gap:14px}.site-footer nav{gap:14px}.site-footer nav a,.site-footer>small{font-size:7px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
<style is:global>
  .site-header{grid-template-columns:1fr auto 1fr}.site-header>.primary-nav{justify-self:center}
  @media(max-width:900px){.site-header{height:92px;grid-template-columns:auto 1fr auto;grid-template-rows:56px 36px;padding:0 5%}.site-header>.brand{grid-column:1;grid-row:1}.site-header>.primary-nav{display:flex;grid-column:1/-1;grid-row:2;justify-self:stretch;justify-content:flex-start;gap:22px;overflow-x:auto;white-space:nowrap;scrollbar-width:none}.site-header>.primary-nav::-webkit-scrollbar{display:none}.site-header>.header-actions{grid-column:3;grid-row:1}.site-main{padding-top:92px}}
  @media(max-width:600px){.site-header{height:88px;grid-template-rows:53px 35px}.site-header>.primary-nav{gap:20px}.site-header>.primary-nav a{font-size:10px}.site-main{padding-top:88px}}
</style>
