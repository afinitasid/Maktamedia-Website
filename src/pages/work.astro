---
import SiteLayout from '../layouts/SiteLayout.astro';
const clients = [
  {name:'Maro',category:'Hair care',idx:'01',tone:'maro',mark:'M'},
  {name:'Keey Studio',category:'Fashion',idx:'02',tone:'keey',mark:'K'},
  {name:'Pyramids of Chi',category:'Wellness',idx:'03',tone:'pyramids',mark:'P'},
  {name:'Suka Home',category:'Home & living',idx:'04',tone:'suka',mark:'S'},
  {name:'Senja Bercerita',category:'Gifting',idx:'05',tone:'senja',mark:'S'},
];
---
<SiteLayout title="Selected Work" description="Selected direct brand partnerships and categories served by Makta Media.">
  <section class="page work-page">
    <div class="page-topline"><span>MAKTA MEDIA · SELECTED PARTNERSHIPS</span><a href="/contact">Discuss your goals <span>↗</span></a></div>
    <div class="work-hero reveal-in"><p class="eyebrow">CURRENT PORTFOLIO</p><h1 class="page-title">Brands we work<br />with <em>today.</em></h1><p class="page-intro">Direct brand partnerships across hair care, fashion, wellness, home and gifting.</p></div>
    <div class="work-grid">{clients.map((client,i)=><article class={`work-card ${client.tone} reveal-in`} style={`--i:${i}`}><div class="work-art"><span>{client.idx} / CURRENT PARTNER</span><div class="work-orbit"><i></i><b>{client.mark}</b></div><small>{client.category.toUpperCase()}</small><a href="/contact" aria-label={`Ask Makta about working with ${client.name}`}>↗</a></div><div class="work-info"><div><h2>{client.name}</h2><p>{client.category}</p></div><span>PARTNERSHIP <b>↗</b></span></div></article>)}</div>
    <div class="work-note"><span>DIRECT BRAND PARTNERSHIPS</span><p>Makta also supports additional campaigns through a trusted agency collaboration. <a href="/contact">Ask us about our experience ↗</a></p></div>
    <div class="experience-note panel"><p class="eyebrow">EXPERIENCE FROM PREVIOUS ROLES</p><p>Across e-commerce, FMCG, fintech, luxury, consumer technology and SaaS—among brands including Samsung, Dior, Longchamp, Lexus, GoPay, Traveloka Eats and Tiket.com.</p></div>
  </section>
</SiteLayout>
<style>
  .work-hero{margin:72px 0 54px}.work-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.work-card{min-width:0;animation-delay:calc(var(--i)*.08s)}.work-art{height:clamp(240px,29vw,385px);position:relative;overflow:hidden;padding:15px;background:radial-gradient(ellipse at 50% 55%,#968470,#48453c 77%)}.work-card.keey .work-art{background:radial-gradient(ellipse at 50% 55%,#a48b77,#484039 78%)}.work-card.pyramids .work-art{background:radial-gradient(ellipse at 50% 53%,#ab9678,#484638 78%)}.work-card.suka .work-art{background:radial-gradient(ellipse at 50% 53%,#ae9678,#49453a 78%)}.work-card.senja .work-art{background:radial-gradient(ellipse at 50% 53%,#a77855,#47382e 78%)}.work-art>span,.work-art>small{position:absolute;z-index:2;font:7px var(--mono);letter-spacing:.08em;color:#f1e9dc}.work-art>small{bottom:15px;left:15px}.work-art>a{position:absolute;bottom:12px;right:16px;color:#ff966e;font-size:15px}.work-orbit{position:absolute;left:50%;top:52%;width:55%;aspect-ratio:1;transform:translate(-50%,-50%);border:1px solid #eee8dc80;border-radius:50%;animation:drift 12s linear infinite}.work-orbit:before,.work-orbit:after{content:'';position:absolute;inset:14% -15%;border:1px solid #eee8dc70;border-radius:50%;transform:rotate(-38deg)}.work-orbit:after{inset:20% -17%;transform:rotate(43deg)}.work-orbit i{position:absolute;inset:20%;border-radius:50%;background:radial-gradient(circle at 35% 30%,#f1dfc8,#df8458 44%,#594238 83%);box-shadow:0 0 45px #ffbd9066}.work-orbit b{position:absolute;z-index:1;inset:0;display:grid;place-items:center;font:500 clamp(37px,5vw,66px) var(--display);color:#fff3e0b0}.work-info{display:flex;align-items:center;justify-content:space-between;padding:14px 2px;border-bottom:1px solid var(--rule)}.work-info h2{margin:0 0 5px;font:600 14px var(--display)}.work-info p{margin:0;font-size:9px;color:#a9a398}.work-info>span{font:7px var(--mono);color:#aaa398}.work-info>span b{color:var(--accent)}.work-note{display:flex;justify-content:space-between;gap:20px;margin:20px 0 54px;font:8px var(--mono);letter-spacing:.07em;color:#aaa398}.work-note p{max-width:530px;margin:0;text-align:right;font:10px/1.7 var(--sans);letter-spacing:0}.work-note a{color:var(--accent)}.experience-note{display:grid;grid-template-columns:.6fr 1.4fr;gap:30px;align-items:center}.experience-note>p:last-child{color:#c2bcaf;font-size:11px;line-height:1.8}@keyframes drift{to{transform:translate(-50%,-50%) rotate(360deg)}}@media(max-width:800px){.work-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.work-art{height:48vw}.experience-note{grid-template-columns:1fr;gap:10px}}@media(max-width:550px){.work-hero{margin:54px 0 36px}.work-grid{grid-template-columns:1fr}.work-art{height:82vw;max-height:390px}.work-note{display:block}.work-note p{text-align:left;margin-top:10px}}
</style>
