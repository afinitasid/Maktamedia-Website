---
import SiteLayout from '../layouts/SiteLayout.astro';
const brands = ['Samsung','Dior','Longchamp','Lexus','Carro','Bank UOB','Bank Jago','GoPay','Midtrans','AWS','Pijar Kampus','GoBiz','The Body Shop','Skin Dewi','Handy Clean','Kalpanax','Entrostop','Dettol','Konimex','GoFood','Traveloka Eats','Tiket.com'];
const credentials = ['Google Search Ads','Search Ads 360','Google Analytics','Shopping Ads','Apple Search Ads'];
---
<SiteLayout title="About" description="Meet Makta Media, a boutique performance advertising agency working across Indonesia and Southeast Asia.">
  <section class="page about-page">
    <div class="page-topline"><span>THE MAKTA APPROACH · SMALL TEAM, SENIOR ATTENTION</span><span>JAKARTA · ID / SG</span></div>
    <div class="about-hero reveal-in"><p class="eyebrow">ABOUT MAKTA MEDIA</p><h1 class="page-title">Agency-grade rigour,<br /><em>boutique attention.</em></h1><p class="page-intro">Good media is more than a set of campaigns. It is a close understanding of a business, careful execution and clear answers about what is working.</p></div>
    <div class="founder-block panel reveal-in delay"><div class="founder-mark">a.</div><div><small>FOUNDER & STRATEGY DIRECTOR</small><h2>Ashanta Setiadi</h2></div><span class="founder-caption">SENIOR-LED BY DESIGN <b>✳</b></span></div>
    <div class="about-columns"><div><p class="eyebrow">HANDS-ON EXPERIENCE</p><h2 class="subhead">5+ years building<br />performance <em>with intent.</em></h2></div><div><p>Led by a certified specialist with a track record across senior industry roles, Makta brings full-funnel paid media strategy and execution together with analytics and attribution to understand what worked.</p><p>Experience spans e-commerce, FMCG, fintech, luxury, consumer technology and SaaS, across Indonesia and Southeast Asia.</p><div class="markets"><span>INDONESIA</span><i>✳</i><span>SINGAPORE</span><i>✳</i><span>SOUTHEAST ASIA</span></div></div></div>
    <div class="credential-band"><p class="eyebrow">MULTI-PLATFORM CERTIFIED</p><div>{credentials.map((name)=><span>{name}</span>)}</div></div>
    <div class="experience"><div><p class="eyebrow">EXPERIENCE FROM PREVIOUS ROLES</p><h2 class="subhead">Across categories.<br /><em>Across the region.</em></h2><p class="previous">Brands encountered in previous agency and in-house roles.</p></div><div class="brand-cloud">{brands.map((name)=><span>{name}</span>)}</div></div>
    <div class="cta-band"><h2>Let's make your next step <em>clearer.</em></h2><a class="accent-link" href="/contact">MEET MAKTA <span>↗</span></a></div>
  </section>
</SiteLayout>
<style>
  .about-hero{margin:86px 0 58px}.about-hero .page-intro{max-width:600px}.founder-block{display:flex;align-items:center;gap:18px;padding:24px 28px}.founder-mark{width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:#201910;font:italic 24px var(--display)}.founder-block small{font:8px var(--mono);color:#aaa398;letter-spacing:.1em}.founder-block h2{margin:6px 0 0;font:600 18px var(--display)}.founder-caption{margin-left:auto;color:#aaa398;font:8px var(--mono);letter-spacing:.08em}.founder-caption b{color:var(--accent);margin-left:9px}.about-columns{display:grid;grid-template-columns:1fr 1fr;gap:12%;padding:76px 0;border-bottom:1px solid var(--rule)}.subhead{margin:20px 0;font:600 clamp(32px,4vw,51px)/1.08 var(--display);letter-spacing:-.07em}.subhead em{color:var(--accent);font-style:normal}.about-columns>div+div p{color:#c2bcaf;font-size:12px;line-height:1.9}.markets{display:flex;gap:10px;align-items:center;margin-top:24px;color:#c8c0b2;font:8px var(--mono);letter-spacing:.1em}.markets i{color:var(--accent);font-style:normal}.credential-band{padding:33px 0;border-bottom:1px solid var(--rule)}.credential-band>div{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.credential-band>div span,.brand-cloud span{padding:10px 12px;border:1px solid var(--rule);color:#d3cbbc;font-size:9px}.experience{display:grid;grid-template-columns:.8fr 1.2fr;gap:9%;align-items:center;padding:67px 0 0}.experience .subhead{font-size:clamp(29px,3.5vw,44px)}.previous{font-size:10px;color:#aaa398}.brand-cloud{display:flex;flex-wrap:wrap;gap:7px}.brand-cloud span{padding:9px;font-size:8px;transition:border-color .2s,color .2s}.brand-cloud span:hover{border-color:#f4774370;color:var(--accent)}@media(max-width:700px){.about-hero{margin:56px 0 39px}.founder-block{padding:17px}.founder-caption{max-width:85px;text-align:right;line-height:1.7}.about-columns,.experience{grid-template-columns:1fr;gap:22px;padding:46px 0}.credential-band{padding:25px 0}.credential-band>div span{font-size:8px}.experience{padding-top:42px}}
</style>
