---
const platforms = [
  ['Google Search', 'INTENT', 'Reach people actively searching for the products and services you offer.', 'Keywords · Ad creative · Smart bidding · Negative keywords'],
  ['Google Shopping', 'PRODUCT DISCOVERY', 'Put product, price and brand in front of shoppers ready to compare.', 'Merchant Center · Product feeds · Best sellers · Promotions'],
  ['Performance Max', 'FULL FUNNEL', 'Connect Google Search, YouTube, Gmail and Display with the right campaign signals.', 'Creative · Audience signals · Asset insights'],
  ['Meta Ads', 'DEMAND', 'Build interest on Facebook and Instagram, then reconnect with people ready to buy.', 'Custom audiences · Retargeting · Reels · Conversion tracking'],
  ['TikTok Shop', 'SOCIAL COMMERCE', 'Support product and LIVE GMV Max with video creative built for shopping.', 'Product GMV Max · LIVE GMV Max · Creator content'],
  ['Microsoft Ads', 'SEARCH', 'Reach search audiences on Bing with LinkedIn targeting available for B2B.', 'Search campaigns · LinkedIn signals · Shopping'],
  ['Analytics & attribution', 'MEASUREMENT', 'Understand which channels contribute to conversions and revenue.', 'GA4 · AppsFlyer · Adobe Analytics · Cross-channel ROAS'],
];
const categories = ['Beauty & skincare', 'Cosmetics & haircare', 'Fashion & lifestyle', 'General e-commerce', 'Consumer electronics', 'FMCG & F&B'];
const contexts = ['Beauty & skincare', 'Cosmetics & FMCG', 'Consumer electronics', 'Fintech & SaaS', 'Fashion & lifestyle'];
const clients = [
  { name: 'Maro', category: 'Hair care', index: '01', style: 'maro' },
  { name: 'Keey Studio', category: 'Fashion', index: '02', style: 'keey' },
  { name: 'Pyramids of Chi', category: 'Wellness', index: '03', style: 'pyramids' },
  { name: 'Suka Home', category: 'Home & living', index: '04', style: 'suka' },
  { name: 'Senja Bercerita', category: 'Gifting', index: '05', style: 'senja' },
];
const history = ['Samsung', 'Dior', 'Longchamp', 'Lexus', 'Carro', 'Bank UOB', 'Bank Jago', 'GoPay', 'Midtrans', 'AWS', 'Pijar Kampus', 'GoBiz', 'The Body Shop', 'Skin Dewi', 'Handy Clean', 'Kalpanax', 'Entrostop', 'Dettol', 'Konimex', 'GoFood', 'Traveloka Eats', 'Tiket.com'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06080d" />
    <meta name="description" content="Performance advertising for beauty and lifestyle brands across Indonesia and Singapore. Built around your business by Makta Media." />
    <title>Makta Media — Every click is an auction</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <header class="header" id="site-header">
      <a class="logo" href="#top" aria-label="Makta Media home"><span class="logo-mark" aria-hidden="true"></span><span class="logo-wordmark"><strong>makta</strong><span>media</span></span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/calculator">Calculator</a><a href="/services">Services</a><a href="/about">About</a><a href="/work">Work</a><a href="/blog">Blog</a>
      </nav>
      <div class="header-right"><a class="header-contact" href="/contact">LET'S TALK <span>↗</span></a></div>
    </header>
    <main id="top">
      <section class="hero hero-auction" aria-labelledby="hero-title">
        <div class="hero-atmosphere" aria-hidden="true"><div class="hero-halo" data-parallax-speed=".12"></div><div class="hero-field" data-parallax-speed=".26"></div><div class="hero-grain"></div><span class="hero-coordinate">PERFORMANCE MEDIA · ID / SG</span></div>
        <div class="hero-layout"><div class="hero-content">
          <p class="eyebrow"><span class="status-dot"></span> DIGITAL ADS AGENCY · JAKARTA</p>
          <h1 id="hero-title">Every click is<br />an <em>auction.</em><br />We win them.</h1>
          <p class="hero-description">Makta Media runs Google, Meta and Microsoft Ads for beauty and lifestyle brands across Indonesia and Singapore. Enterprise-grade media buying, without the enterprise layers.</p>
          <div class="hero-actions"><a class="button button-cyan" href="#contact">Book a free audit <span>↗</span></a><a class="button button-quiet" href="#work">View portfolio <span>↓</span></a></div>
          <div class="hero-stats"><div><b>5+</b><span>YEARS RUNNING ADS</span></div><div><b>5</b><span>ACTIVE CLIENTS</span></div><div><b>ID·SG</b><span>MARKETS SERVED</span></div></div>
        </div></div>
        <div class="hero-baseline"><span>GOOGLE · META · MICROSOFT</span><span>BEAUTY & LIFESTYLE · ID / SG</span><span>SCROLL TO EXPLORE ↓</span></div>
        <button class="motion-toggle" aria-label="Pause background motion" aria-pressed="false"><span class="pause-icon">Ⅱ</span></button>
      </section>
      <section class="context-strip" aria-label="Industries served"><div class="context-label">INDUSTRIES SERVED</div><div class="context-track">{contexts.map((context) => <span>{context}<i>✳</i></span>)}{contexts.map((context) => <span aria-hidden="true">{context}<i>✳</i></span>)}</div></section>
      

<section class="work section-wrap" id="work">
        <div class="section-top"><span>SELECTED PARTNERSHIPS</span><a href="#contact">Discuss your goals <b>↗</b></a></div>
        <div class="section-heading"><div><p class="eyebrow">CURRENT PORTFOLIO</p><h2>Brands we work<br />with <em>today.</em></h2></div><p class="heading-note">Direct brand partnerships across hair care, fashion, wellness, home and gifting.</p></div>
        <div class="work-grid">
          {clients.map((client) => <article class:list={['work-card', client.style]}><a href="#contact" aria-label={'Ask about ' + client.name + ' partnership'}><div class="work-art"><span class="art-index">{client.index} / CURRENT PARTNER</span><div class="visual-object"><i></i><b>{client.name.slice(0, 1)}</b></div><span class="art-caption">{client.category.toUpperCase()}</span><span class="art-arrow">↗</span></div><div class="work-card-info"><div><h3>{client.name}</h3><p>{client.category}</p></div><span>PARTNERSHIP <b>↗</b></span></div></a></article>)}
        </div>
        <div class="work-foot"><span>THESE ARE DIRECT PARTNERSHIPS.</span><p>We also support additional campaigns through a trusted agency collaboration. <a href="#contact">Ask us about our experience ↗</a></p></div>
      </section>
<section class="services" id="services">
        <div class="service-backdrop" aria-hidden="true"></div>
        <div class="service-inner section-wrap"><div class="section-top"><span>WHAT WE DO</span><span>ONE CONNECTED MEDIA SYSTEM</span></div><div class="section-heading"><div><p class="eyebrow">FROM THE FIRST SEARCH TO THE NEXT ORDER</p><h2>Find your people.<br /><em>Earn their attention.</em></h2></div><p class="heading-note">We plan and manage the paid channels that help a good business get discovered, considered and chosen.</p></div>
          <div class="service-list">{platforms.map(([name, type, summary, tools], i) => <div class="service-row"><span class="service-num">0{i + 1}</span><div class="service-name"><h3>{name}</h3><small>{type}</small></div><div class="service-summary"><p>{summary}</p><small>{tools}</small></div><span class="service-arrow">↗</span></div>)}</div>
          <p class="service-note"><span>↗</span> Channel choice follows your customers and your goals. We shape the mix around your business.</p>
        </div>
      </section>



      
      
      
      
      <section class="about section-wrap" id="about">
        <div class="section-top"><span>THE MAKTA APPROACH</span><span>SMALL TEAM · SENIOR ATTENTION</span></div>
        <div class="about-layout"><div class="about-title"><p class="eyebrow">ABOUT US</p><h2>Agency-grade rigour,<br /><em>boutique attention.</em></h2><div class="founder"><span class="founder-mark">a.</span><span><b>Ashanta Setiadi</b><small>FOUNDER & STRATEGY DIRECTOR</small></span></div></div><div class="about-copy"><p class="about-lead">5+ years of hands-on performance advertising for global and regional brands.</p><p>Led by a certified specialist with a track record across senior industry roles, Makta brings full-funnel paid media strategy and execution together with analytics and attribution to prove what worked.</p><p>Experience spans e-commerce, FMCG, fintech, luxury, consumer tech and SaaS, across Indonesia and Southeast Asia.</p><div class="markets"><span>INDONESIA</span><i>✳</i><span>SINGAPORE</span><i>✳</i><span>SOUTHEAST ASIA</span></div></div></div>
        <div class="credentials"><p class="eyebrow">MULTI-PLATFORM CERTIFIED</p><div>Google Search Ads <i>✳</i> Search Ads 360 <i>✳</i> Google Analytics <i>✳</i> Shopping Ads <i>✳</i> Apple Search Ads</div></div>
        <div class="experience"><div><p class="eyebrow">EXPERIENCE FROM PREVIOUS ROLES</p><h3>Across categories.<br /><em>Across the region.</em></h3><p>Brands encountered in previous agency and in-house roles.</p></div><div class="brand-cloud">{history.map((name) => <span>{name}</span>)}</div></div>
      </section>
<section class="reach section-wrap" id="calculator"><div class="section-top"><span>REACH ESTIMATOR</span><span>PLAN YOUR AD SPEND</span></div><div class="reach-layout"><div><p class="eyebrow">HOW FAR DOES YOUR BUDGET GO?</p><h2>See what your<br />budget can <em>reach.</em></h2><p>Set a monthly budget, pick a platform and a category. Explore a typical range of clicks and impressions in this market.</p><a class="text-link" href="#contact">Want a number based on your actual account? <b>Book a free audit ↗</b></a></div><div class="reach-tool"><div class="reach-field"><label>PLATFORM</label><div class="reach-options platforms"><button class="active" data-platform="google">Google Search</button><button data-platform="meta">Meta Ads</button><button data-platform="microsoft">Microsoft Ads</button></div></div><div class="reach-field"><label for="budget">MONTHLY BUDGET <strong id="budget-value">Rp 25 juta</strong></label><input id="budget" type="range" min="1" max="100" value="25" /><div class="budget-range"><span>Rp 1 jt</span><span>Rp 50 jt</span><span>Rp 100 jt</span></div></div><div class="reach-field"><label>BUSINESS CATEGORY</label><div class="reach-options category-options">{categories.map((category, i) => <button class:list={i === 0 ? ['active'] : []} data-category={['beauty','cosmetics','fashion','commerce','electronics','fmcg'][i]}>{category}</button>)}</div></div><div class="reach-results"><div><small>ESTIMATED CLICKS</small><b id="click-range">2.5K — 6.3K</b></div><div><small>ESTIMATED IMPRESSIONS</small><b id="impression-range">125K — 331K</b></div></div><p class="reach-disclaimer">Conservative to optimistic range. Real delivery varies with competition, Quality Score and seasonality. This is a planning tool, not a performance guarantee.</p></div></div></section>


      <section class="contact" id="contact"><div class="contact-light" aria-hidden="true"></div><div class="contact-content section-wrap"><p class="eyebrow"><span class="status-dot"></span> THE FIRST CONVERSATION IS ON US</p><h2>Where do you<br />want to <em>grow?</em></h2><p>Start with a free 30-minute audit. We will review your campaigns and share what we see. No pitch, no pressure.</p><div class="contact-actions"><a class="button button-cyan" href="mailto:maktamedia@gmail.com?subject=Free%20campaign%20audit">Book a free audit <span>↗</span></a><a class="contact-email" href="mailto:maktamedia@gmail.com">maktamedia@gmail.com</a></div><div class="contact-details"><span>JAKARTA, INDONESIA</span><span>+62 813 7000 689</span><span>WORKING ACROSS ID · SG</span></div></div></section>
    </main>
    <footer class="footer"><a class="logo" href="#top" aria-label="Makta Media home"><span class="logo-mark" aria-hidden="true"></span><span class="logo-wordmark"><strong>makta</strong><span>media</span></span></a><p>Performance advertising, built around your business.</p><a href="#top">BACK TO TOP ↑</a><small>© 2026 MAKTA MEDIA</small></footer>
    <script>
      const budget = document.querySelector('#budget');
      let selectedPlatform = 'google', selectedCategory = 'beauty';
      const cpc = { google:{beauty:4000,cosmetics:4300,fashion:3500,commerce:4500,electronics:5200,fmcg:3900}, meta:{beauty:2500,cosmetics:2700,fashion:2200,commerce:3000,electronics:3600,fmcg:2400}, microsoft:{beauty:5000,cosmetics:5300,fashion:4600,commerce:5200,electronics:5800,fmcg:4900} };
      const compact = (n) => n >= 1000000 ? (n / 1000000).toFixed(1).replace('.0','') + 'M' : n >= 1000 ? Math.round(n / 1000) + 'K' : String(n);
      function updateReach() { const spend = Number(budget.value) * 1000000; const rate = cpc[selectedPlatform][selectedCategory]; const low = Math.round(spend / (rate * 1.6)); const high = Math.round(spend / (rate * .8)); document.querySelector('#budget-value').textContent = 'Rp ' + budget.value + ' juta'; document.querySelector('#click-range').textContent = compact(low) + ' — ' + compact(high); document.querySelector('#impression-range').textContent = compact(low * 50) + ' — ' + compact(high * 53); budget.style.setProperty('--fill', ((budget.value - 1) / 99 * 100) + '%'); }
      budget.addEventListener('input', updateReach);
      document.querySelectorAll('.platforms button').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('.platforms button').forEach((item) => item.classList.remove('active')); button.classList.add('active'); selectedPlatform = button.dataset.platform; updateReach(); }));
      document.querySelectorAll('.category-options button').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('.category-options button').forEach((item) => item.classList.remove('active')); button.classList.add('active'); selectedCategory = button.dataset.category; updateReach(); }));
      updateReach();
      const motionToggle = document.querySelector('.motion-toggle');
      motionToggle.addEventListener('click', () => { const paused = document.body.classList.toggle('motion-paused'); motionToggle.setAttribute('aria-pressed', String(paused)); motionToggle.setAttribute('aria-label', paused ? 'Play background motion' : 'Pause background motion'); motionToggle.querySelector('span').textContent = paused ? '▶' : 'Ⅱ'; });
      const reveals = document.querySelectorAll('.work-card,.service-row,.principle,.experience,.about-title,.about-copy,.contact-content');
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); } }), { threshold: .14 });
      reveals.forEach((el) => { el.classList.add('reveal'); observer.observe(el); });
      let ticking = false;
      window.addEventListener('scroll', () => { if (ticking) return; ticking = true; requestAnimationFrame(() => { const max = document.documentElement.scrollHeight - innerHeight; document.querySelector('.progress').style.transform = 'scaleX(' + (max ? scrollY / max : 0) + ')'; if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('[data-parallax-speed]').forEach((el) => el.style.translate = '0 ' + (scrollY * Number(el.dataset.parallaxSpeed)) + 'px'); ticking = false; }); }, { passive: true });
    </script>
  </body>
</html>
<style>
  :root{--night:#06080d;--night2:#0b1019;--panel:#101722;--white:#f4f7fb;--soft:#a7b0bd;--cyan:#baf7ff;--cyan2:#65dcec;--line:rgba(215,230,244,.15);--display:'Sora',sans-serif;--body:'Inter',sans-serif;--mono:'DM Mono',monospace}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:76px}body{margin:0;background:var(--night);color:var(--white);font-family:var(--body);-webkit-font-smoothing:antialiased}body.menu-open{overflow:hidden}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit}.progress{position:fixed;z-index:40;left:0;top:0;width:100%;height:2px;background:var(--cyan);transform:scaleX(0);transform-origin:left}.header{height:62px;position:fixed;z-index:30;top:0;left:0;right:0;padding:0 4.2%;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;background:rgba(6,8,13,.75);border-bottom:1px solid rgba(220,234,247,.09);backdrop-filter:blur(18px)}.logo{font:700 17px var(--display);letter-spacing:-1.1px}.logo span{color:var(--cyan)}.desktop-nav{justify-self:center;display:flex;gap:30px}.desktop-nav a{font-size:10px;color:#bec5ce;transition:color .2s}.desktop-nav a:hover{color:var(--cyan)}.header-right{justify-self:end;display:flex;align-items:center;gap:25px}.header-contact{font:9px var(--mono);letter-spacing:.06em}.header-contact span{color:var(--cyan);padding-left:8px}.menu-button{width:31px;height:31px;border:0;background:transparent;display:grid;align-content:center;gap:5px;cursor:pointer}.menu-button span{height:1px;width:19px;background:var(--white);transition:transform .25s}.menu-button[aria-expanded=true] span:first-child{transform:translateY(3px) rotate(45deg)}.menu-button[aria-expanded=true] span:last-child{transform:translateY(-3px) rotate(-45deg)}.menu-panel{position:fixed;inset:0;z-index:29;background:rgba(5,8,14,.98);padding:88px 8% 32px;display:flex;flex-direction:column;justify-content:space-between;opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s}.menu-panel.open{opacity:1;visibility:visible}.menu-panel-top{display:flex;justify-content:space-between;font:8px var(--mono);letter-spacing:.12em;color:#8f9baa}.menu-close{border:0;background:transparent;font:8px var(--mono);color:#bfc9d5;cursor:pointer}.menu-panel nav{display:grid;max-width:800px;width:100%;align-self:center}.menu-panel nav a{display:grid;grid-template-columns:40px 1fr 30px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line);font:500 clamp(28px,5vw,55px) var(--display);letter-spacing:-.06em}.menu-panel nav a small{font:9px var(--mono);color:#8793a0;letter-spacing:0}.menu-panel nav a b{justify-self:end;color:var(--cyan);font:400 17px var(--body)}.menu-foot{font:8px var(--mono);color:#74808f;letter-spacing:.1em}.hero{height:min(900px,100svh);min-height:660px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:90px 7% 82px;text-align:center;background:radial-gradient(ellipse at 50% 50%,#08101b 0%,var(--night) 60%)}.hero-atmosphere{position:absolute;inset:0;overflow:hidden;pointer-events:none}.hero-halo{position:absolute;left:50%;top:46%;width:min(780px,80vw);aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(31,119,183,.19),rgba(13,72,125,.12) 29%,transparent 69%);filter:blur(12px);animation:halo 8s ease-in-out infinite alternate}.hero-beam{position:absolute;width:120%;height:2px;left:-10%;top:59%;transform:rotate(-17deg);background:linear-gradient(90deg,transparent,rgba(111,222,255,.05) 28%,rgba(127,229,255,.8) 51%,rgba(87,178,255,.15) 66%,transparent);box-shadow:0 0 18px 4px rgba(81,199,255,.3),0 0 100px 20px rgba(35,112,226,.15);animation:beam 7.5s ease-in-out infinite}.hero-orbit{position:absolute;left:50%;top:53%;border:1px solid rgba(129,200,255,.09);border-radius:50%;transform:translate(-50%,-50%) rotate(-22deg)}.orbit-a{width:min(720px,80vw);height:min(330px,40vw);animation:orbit 22s linear infinite}.orbit-b{width:min(540px,70vw);height:min(245px,33vw);border-color: