---
import SiteLayout from '../layouts/SiteLayout.astro';
const insights = [
  {n:'01',category:'MEDIA STRATEGY',time:'5 MIN READ',title:'Your budget is not your strategy.',lead:'A bigger budget can buy more opportunities. It cannot decide which ones are worth taking.',body:'A useful media plan starts with the commercial question: what needs to change in the business? From there, channel roles, audience priorities and measurement become clearer. Budget follows that plan. It does not replace it. Start with a target, decide what evidence would move the team forward, then set investment against the opportunity you can actually serve.'},
  {n:'02',category:'FULL-FUNNEL',time:'6 MIN READ',title:'Search and social solve different parts of the same journey.',lead:'One meets existing demand. The other can help create it. Healthy growth needs both jobs understood.',body:'Search often captures people already expressing intent, while social gives brands a way to earn attention before a search happens. Treating their reported conversions as competing totals misses the hand-off between discovery and decision. Give each channel a clear role, track consistent outcomes and look for the combined pattern over time.'},
  {n:'03',category:'MEASUREMENT',time:'4 MIN READ',title:'A useful report should make the next decision easier.',lead:'Metrics are only helpful when the people reading them know what to do next.',body:'A report does not need every available number. It needs the signals that connect spend to business outcomes, a clear comparison period and context for changes in delivery. A good monthly review ends with a small set of decisions: what to keep, what to learn and what to change before the next cycle.'},
];
---
<SiteLayout title="Journal & Insights" description="Notes on paid media strategy, full-funnel growth and measurement from Makta Media.">
  <section class="page blog-page">
    <div class="page-topline"><span>THE MAKTA JOURNAL</span><span>MEDIA · GROWTH · MEASUREMENT</span></div>
    <div class="blog-hero reveal-in"><p class="eyebrow">NOTES FOR THE NEXT DECISION</p><h1 class="page-title">A little more signal.<br /><em>A little less noise.</em></h1><p class="page-intro">Short perspectives on paid media, measurement and the choices behind sustainable growth.</p></div>
    <div class="journal-list">{insights.map((post)=><article class="journal-card reveal-in"><div class="journal-meta"><span>{post.n} / {post.category}</span><span>{post.time}</span></div><h2>{post.title}</h2><p class="lead">{post.lead}</p><details><summary>READ THE NOTE <b>＋</b></summary><p>{post.body}</p></details></article>)}</div>
    <div class="journal-foot"><span>WANT TO DISCUSS A QUESTION FOR YOUR BUSINESS?</span><a class="accent-link" href="/contact">LET'S TALK <span>↗</span></a></div>
  </section>
</SiteLayout>
<style>
  .blog-hero{margin:83px 0 62px}.journal-list{border-top:1px solid var(--rule)}.journal-card{display:grid;grid-template-columns:.55fr 1.3fr 1fr .7fr;gap:24px;align-items:start;padding:31px 0;border-bottom:1px solid var(--rule)}.journal-meta{display:grid;gap:9px;color:#aaa398;font:7px var(--mono);letter-spacing:.07em}.journal-meta span:first-child{color:var(--accent)}.journal-card h2{margin:0;font:600 clamp(21px,2.7vw,34px)/1.1 var(--display);letter-spacing:-.06em}.journal-card .lead{margin:0;color:#c4bdae;font-size:11px;line-height:1.8}.journal-card details summary{list-style:none;cursor:pointer;color:var(--paper);font:8px var(--mono);letter-spacing:.07em}.journal-card details summary::-webkit-details-marker{display:none}.journal-card details summary b{color:var(--accent);margin-left:7px;font-size:12px}.journal-card details[open] summary b{display:inline-block;transform:rotate(45deg)}.journal-card details>p{margin:15px 0 0;color:#b3ad9f;font-size:10px;line-height:1.85}.journal-foot{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:40px;color:#aaa398;font:8px var(--mono);letter-spacing:.07em}@media(max-width:800px){.blog-hero{margin:55px 0 38px}.journal-card{grid-template-columns:1fr 1fr;gap:14px}.journal-meta{grid-column:1/-1;display:flex;justify-content:space-between}.journal-card h2{grid-column:1/-1}.journal-card .lead{grid-column:1}.journal-card details{grid-column:2}.journal-foot{align-items:flex-start;flex-direction:column}}@media(max-width:550px){.journal-card{grid-template-columns:1fr}.journal-card .lead,.journal-card details{grid-column:1}.journal-card details{margin-top:4px}}
</style>
